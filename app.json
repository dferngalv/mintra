{
  "expo": {
    "name": "PruebaInterfacesMintra",
    "slug": "PruebaInterfacesMintra",
    "owner": "mintra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo_mintra.png",
    "scheme": "pruebainterfacesmintra",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logo_mintra.png",
        "backgroundImage": "./assets/images/logo_mintra.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.mintra.PruebaInterfacesMintra"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo_mintra.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo_mintra.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ca0b2c55-9d8e-49d9-9881-a56ad60a5531"
      }
    }
  }
}
